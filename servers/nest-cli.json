{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/ma-server/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "swc",
    "tsConfigPath": "apps/ma-servers/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/ma-servers",
  "projects": {
    "libs": {
      "type": "library",
      "root": "libs/libs",
      "entryFile": "index",
      "sourceRoot": "libs/libs/src",
      "compilerOptions": {
        "tsConfigPath": "libs/libs/tsconfig.lib.json"
      }
    },
    "ma-server/gateway": {
      "type": "application",
      "root": "apps/ma-server/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/ma-server/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ma-server/gateway/tsconfig.app.json"
      }
    },
    "ma-server/ma-admin": {
      "type": "application",
      "root": "apps/ma-server/ma-admin",
      "entryFile": "main",
      "sourceRoot": "apps/ma-server/ma-admin/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ma-server/ma-admin/tsconfig.app.json"
      }
    }
  }
}