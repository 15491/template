{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "swc",
    "tsConfigPath": "apps/gateway/tsconfig.app.json",
    "webpack": true
  },
  "monorepo": true,
  "root": "apps/gateway",
  "generateOptions": {
    "spec": false,
    "flat": true
  },
  "projects": {
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "libs": {
      "type": "library",
      "root": "libs/libs",
      "entryFile": "index",
      "sourceRoot": "libs/libs/src",
      "compilerOptions": {
        "tsConfigPath": "libs/libs/tsconfig.lib.json"
      }
    },
    "ma-admin": {
      "type": "application",
      "root": "apps/ma-admin",
      "entryFile": "main",
      "sourceRoot": "apps/ma-admin/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ma-admin/tsconfig.app.json"
      }
    },
    "ma-mobile": {
      "type": "application",
      "root": "apps/ma-mobile",
      "entryFile": "main",
      "sourceRoot": "apps/ma-mobile/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ma-mobile/tsconfig.app.json"
      }
    },
    "ma-web": {
      "type": "application",
      "root": "apps/ma-web",
      "entryFile": "main",
      "sourceRoot": "apps/ma-web/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ma-web/tsconfig.app.json"
      }
    },
    "ms-auth": {
      "type": "application",
      "root": "apps/ms-auth",
      "entryFile": "main",
      "sourceRoot": "apps/ms-auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ms-auth/tsconfig.app.json"
      }
    },
    "ms-rbac": {
      "type": "application",
      "root": "apps/ms-rbac",
      "entryFile": "main",
      "sourceRoot": "apps/ms-rbac/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ms-rbac/tsconfig.app.json"
      }
    },
    "ms-user": {
      "type": "application",
      "root": "apps/ms-user",
      "entryFile": "main",
      "sourceRoot": "apps/ms-user/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ms-user/tsconfig.app.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    }
  }
}
